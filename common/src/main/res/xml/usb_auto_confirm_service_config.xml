<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep the package filter. It used to be blamed for the service staying silent, but the silence
  came from the handler rejecting every window before reading a node; the handler now decides from
  the window content, and only acts between our own requestPermission() call and its result. Every
  system USB prompt seen on the supported head units is owned by one of these two packages, and
  widening the filter would feed every app's dialogs into a service that clicks "OK".
  "android" covers vendor ROMs that host the AlertDialog in the system process rather than
  systemui. If a prompt is ever confirmed to come from another package, add it here deliberately.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/usb_auto_confirm_desc"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="50"
    android:canRetrieveWindowContent="true"
    android:packageNames="com.android.systemui,android"
    android:accessibilityFlags="flagReportViewIds" />
